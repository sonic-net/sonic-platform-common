def _truthy(v):
    """`Truthy()`: the field is used in a boolean context, so evaluate it as one.

    `LeakageSensorBase.is_leak` is declared bool but Mellanox answers the
    string 'N/A' when the sysfs read fails (liquid_cooling.py:46-57), and the
    Python daemon's `if sensor_is_leak:` (thermalctld:676) therefore treats it
    as leaking.  Normalising the sentinel to None instead would make a failed
    leak sensor read as "not leaking" -- the one direction that matters, since
    bmcctld cuts power on CRITICAL and would never see one.

    None stays None: `if None:` is false in Python too, so an absent reading
    keeps behaving the way the daemon already expects.

    An action's bool answer goes through here too, for the same reason: its
    caller reads it as `if not answer:`.
    """
    return None if v is None else bool(v)


def _scalar(v, sentinels, coerce_from):
    """`Observed()`: a sentinel is a missing reading, not a value.

    Vendors return the number as int, str or a numpy scalar as readily as
    float, at positions the base class documents as float.  Both this and the
    Rust bridge normalise through the same declared table, so the two sides
    cannot disagree about what "no reading" looks like.

    A number that is neither an `int` nor a `float` keeps its fraction: an
    integral one (`numpy.int64`) becomes an int, anything else that converts
    (`Decimal`, `numpy.float32`) becomes a float.  Trying `int()` first
    truncated `Decimal('45.7')` to 45.  A string is the other way round:
    `int()` first keeps every digit of a whole number past 2**53, and
    '45.7', which `int()` refuses, is left to the `str` rule.  Where the
    column is an integer, the bridge narrows it, as it does a float.
    """
    if v is None:
        return None
    for s in sentinels:
        if v == s:
            return None
    if isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return v
    for kind in coerce_from:
        if kind == 'str' and isinstance(v, str):
            try:
                return float(v)
            except ValueError:
                return None
        if kind == 'int':
            if isinstance(v, str):
                try:
                    return int(v)
                except ValueError:
                    continue
            if isinstance(v, numbers.Integral):
                return int(v)
            try:
                return float(v)
            except (TypeError, ValueError):
                pass
    return None

