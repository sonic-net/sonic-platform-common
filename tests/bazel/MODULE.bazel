# Test-only application root. Production images consume the platform-common
# module directly; they do not acquire a dependency back on sonic-buildimage.
module(name = "sonic_platform_common_tests")

bazel_dep(name = "sonic-platform-common", version = "1.0.0", repo_name = "sonic_platform_common")
local_path_override(
    module_name = "sonic-platform-common",
    path = "../..",
)

bazel_dep(name = "sonic-buildimage", version = "0.0.0", repo_name = "sonic_buildimage")
git_override(
    module_name = "sonic-buildimage",
    commit = "c743d7521e80fc1733e5cc0ffc24889b08f78444",
    remote = "https://github.com/securely1g/sonic-buildimage.git",
)

# The image fixture predates the public SONiC registry. Resolve its retired
# dependency versions against the published modules when used from this root.
single_version_override(module_name = "iproute2", version = "6.15.0.sonic.9")
single_version_override(module_name = "libyang", version = "3.12.2.sonic.9")
single_version_override(module_name = "libyang-python", version = "3.1.0.sonic.7")
single_version_override(module_name = "p4c", version = "1.2.4.2.sonic.7")
single_version_override(module_name = "p4lang-bmv2", version = "1.15.0.sonic.6")
single_version_override(module_name = "p4lang-pi", version = "0.1.3.sonic.7")
single_version_override(module_name = "rules_distroless", version = "0.9.4.sonic.26")
single_version_override(module_name = "rules_foreign_cc", version = "0.16.0.sonic.2")
single_version_override(module_name = "socat", version = "1.8.0.2.sonic.8")
single_version_override(module_name = "sonic-dash", version = "0.0.1-d5c003dd7774c2b43f275c0233acc73a0ea28d2f")
single_version_override(module_name = "sonic-dash-api", version = "0.0.6-55310bf7437d67411418c974587adcdc1b194d6b")
single_version_override(module_name = "sonic-fips", version = "1.11.0-2ed0920f2fea7940f4b2b7f5c37e51e225eb1ea6")
single_version_override(module_name = "sonic-sairedis", version = "0.0.5-6b9b254c0d083f3c75e20c61e88e083a7acf0a67")
single_version_override(module_name = "sonic-swss-common", version = "0.0.8-2a4ddd070edb719f2e969a880a5cfff711e64e72")
single_version_override(module_name = "sonic-yang-models", version = "1.0.1-dd732f9512a84966487951250adae8e3e5c9943e")

# The pinned image requests SWSS at 0.0.0 and its overrides are not inherited.
single_version_override(
    module_name = "sonic-swss",
    version = "0.0.3-9c3797990d4b5a79100a40fe7689927c18212361",
)

single_version_override(
    module_name = "rules_go",
    version = "0.65.0.sonic.2",
)

single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)

single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5.sonic.2",
)

single_version_override(
    module_name = "libnl3",
    version = "3.7.0.sonic.10",
)

single_version_override(
    module_name = "re2",
    version = "2024-07-02.bcr.1",
)

single_version_override(
    module_name = "sonic-build-infra",
    version = "0.0.44-35726399908a3beb947174e9359f902077928289",
)

single_version_override(
    module_name = "sonic-rust-deps",
    version = "0.0.5-5bf69bc0a7d9ea9f4a5606264be592867cd29d1e",
)

bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26")
bazel_dep(name = "rules_python", version = "1.9.0.sonic.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.44-35726399908a3beb947174e9359f902077928289", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "0.0.8-2a4ddd070edb719f2e969a880a5cfff711e64e72", repo_name = "sonic_swss_common")

# The test image and the shared toolchains must use the same APT package graph.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.import_lock(lock = "@sonic_build_infra//apt:apt.lock.json")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)
python.toolchain(python_version = "3.11")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "platform_tests_pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "platform_tests_pip")

# The image's Rust extension requires a root tag even for Python-only tests.
# No Rust target participates in this test application.
bazel_dep(name = "rules_rs", version = "0.1.0")

rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(versions = [])
