{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>sonic-net/sonic-pipelines//renovate/default"],
  "packageRules": [
    {
      "description": "Keep the bridge and provider on the same PyO3 version.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["pyo3"],
      "groupName": "PyO3",
      "rangeStrategy": "bump"
    }
  ]
}