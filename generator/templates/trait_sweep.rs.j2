{%- for row in model.rows if row.projected %}

#[test]
fn every_{{ row.name | snake }}_column_has_a_bit_and_a_name_of_its_own() {
    let mut seen = {{ row.name }}Cols::NONE;
    for col in {{ row.name }}Col::ALL {
        assert!(!seen.contains(*col), "{} shares a bit", col.as_str());
        seen = seen.with({{ row.name }}Cols::of(*col));
    }
    assert_eq!(seen, {{ row.name }}Cols::ALL);
    assert_eq!(seen.bits(), {{ row.name }}Cols::ALL.bits());
{%- for f in row.fields %}{% if f.col_bit is not none %}
    assert_eq!({{ row.name }}Col::{{ f.name | camel }}.as_str(), {{ f.name | tojson }});
    assert_eq!({{ row.name }}Cols::{{ f.name | upper }}, {{ row.name }}Cols::of({{ row.name }}Col::{{ f.name | camel }}));
{%- endif %}{% endfor %}
    assert_eq!(format!("{:?}", {{ row.name }}Cols::NONE), "{{ row.name }}Cols[]");
    assert!(format!("{:?}", {{ row.name }}Cols::ALL).starts_with("{{ row.name }}Cols["));
}
