def _call(fn, default=None):
    """Invoke a base-class getter, or say it is not there.

    Three ways a platform declines to answer, collapsed into one: the method
    is absent, it raises `NotImplementedError`, or it returns None.  A fourth
    -- `return NotImplementedError`, which five base-class methods write and
    which hands back a truthy class object -- is caught here too.
    """
    if fn is None:
        return default
    try:
        r = fn()
    except NotImplementedError:
        return default
    if r is None or r is NotImplementedError:
        return default
    return r


def _get(obj, name):
    return getattr(obj, name, None)


def _iter(seq):
    return seq if seq is not None else ()


def _pairs(mapping):
    """A mapping as (key, value) pairs, in the order the platform read them.

    Nothing for a platform that answered something other than a mapping: this
    runs in a polling loop, and the alternative is an AttributeError every
    cycle on hardware that is merely unusual.
    """
    return mapping.items() if hasattr(mapping, 'items') else ()


def _one(obj):
    """A singular accessor as a list of at most one.

    `get_watchdog()` answers one object or nothing.  Iterating it directly
    would be a TypeError on most platforms, and on one that answered a string
    it would be one row per character.
    """
    return () if obj is None else (obj,)


def _default(v, d):
    return d if v is None else v


def _at(v, i):
    """One slot of a fixed-arity tuple return.

    A platform that answered with something unindexable, or with a shorter
    tuple than the base class documents, reads as absent rather than as a
    crash in a polling loop.

    A platform that answered a bare string instead of the tuple means the
    whole string, the way chassisd reads `get_midplane_down_reason()`: it is
    the first slot, and there is no second.  Indexing it would split the
    reason into characters.
    """
    if v is None:
        return None
    if isinstance(v, str):
        return v if i == 0 else None
    try:
        return v[i]
    except (TypeError, IndexError, KeyError):
        return None


def _fmt(v, template, parent, i):
    """A name, or the key its consumers already publish it under."""
    if v is not None:
        return str(v)
    return template.format(parent=parent, i=i + 1)


def _enum(v):
    """A column the stub declares as one of a fixed set of strings.

    The base classes document these as `str`, but a vendor is free to answer
    with an `enum.Enum` whose *value* is that string -- mlnx's
    `get_leak_severity()` does.  Both spellings mean the same thing to a
    Python caller, so the difference went unnoticed until the Rust bridge,
    which downcasts to `str`, failed the whole row read.

    Normalising here rather than in the bridge keeps the two sides reading the
    same declaration: the stub says the column is a string, so it crosses as
    one.
    """
    return v.value if isinstance(v, enum.Enum) else v


def _call_with_name(name_fn, fn):
    """`WithName()`: a getter that takes the device's own name.

    `ModuleBase.get_module_state_transition(module_name)` is one; Python passes
    the name too (`chassisd:1271`).  Called with no argument it raises, and
    since a row is built eagerly that one column takes the whole row with it --
    on a SmartSwitch NPU it left chassisd logging "Failed to read the modules"
    every cycle with no CHASSIS_MIDPLANE_TABLE published.

    The name is read through the same `get_name()` the row's own `name` column
    uses, so the two cannot drift apart.
    """
    if fn is None:
        return None
    name = _call(name_fn)
    if name is None:
        return None
    try:
        r = fn(name)
    except NotImplementedError:
        return None
    return None if (r is None or r is NotImplementedError) else r


def _call_narrowed(fn):
    """`Narrowed()`: a vendor that narrowed the signature has no answer here.

    `ChassisBase.get_dpu_id` is `(self, **kwargs)` in the base class and
    `(self, name)` on Mellanox, so the zero-argument call the row makes raises
    TypeError on a SmartSwitch NPU.  The row is built eagerly, so without this
    that one column takes the whole `ChassisInfo` with it -- and the caller
    that only wanted `is_smartswitch` reads None and concludes the platform is
    a fixed switch.

    Narrow on purpose: `_call` does not catch TypeError, because everywhere
    else a TypeError means the generator emitted the wrong call.
    """
    if fn is None:
        return None
    try:
        return _call(fn)
    except TypeError:
        return None


def _truthy(v):
    """`Truthy()`: the field is used in a boolean context, so evaluate it as one.

    `LeakageSensorBase.is_leak` is declared bool but Mellanox answers the
    string 'N/A' when the sysfs read fails (liquid_cooling.py:46-57), and the
    Python daemon's `if sensor_is_leak:` (thermalctld:676) therefore treats it
    as leaking.  Normalising the sentinel to None instead would make a failed
    leak sensor read as "not leaking" -- the one direction that matters, since
    bmcctld cuts power on CRITICAL and would never see one.

    None stays None: `if None:` is false in Python too, so an absent reading
    keeps behaving the way the daemon already expects.
    """
    return None if v is None else bool(v)


def _scalar(v, sentinels, coerce_from):
    """`Observed()`: a sentinel is a missing reading, not a value.

    Vendors return the number as int, str or a numpy scalar as readily as
    float, at positions the base class documents as float.  Both this and the
    Rust bridge normalise through the same declared table, so the two sides
    cannot disagree about what "no reading" looks like.
    """
    if v is None:
        return None
    for s in sentinels:
        if v == s:
            return None
    if isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return v
    for kind in coerce_from:
        if kind == 'str' and isinstance(v, str):
            try:
                return float(v)
            except ValueError:
                return None
        if kind == 'int':
            try:
                return int(v)
            except (TypeError, ValueError):
                pass
    return None

